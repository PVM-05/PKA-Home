# CẤU HÌNH MÔI TRƯỜNG SẢN PHẨM (PRODUCTION) - PKA-HOME
APP_ENV=production
API_BASE_URL=https://api.pkahome.vn

# Supabase Production Instance (Bảo mật nghiêm ngặt)
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_production_live_key

# Giám sát Uptime & Cảnh báo Sự cố Thời gian thực (Production Alerting)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-100987654321
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX

# Tắt toàn bộ verbose logging trên môi trường Production
ENABLE_DEBUG_LOGGING=false
