// Copy nội dung này dán vào https://dbdiagram.io/ để xem biểu đồ quan hệ thực thể (ERD) hoàn chỉnh

Table users {
  id uuid [primary key, note: 'Khóa ngoại tới auth.users(id) ON DELETE CASCADE']
  full_name varchar [not null]
  phone varchar
  role user_role [not null, default: 'resident', note: 'resident, admin, accountant, technician, management']
  is_locked boolean [default: false, note: 'Khóa tài khoản']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table apartments {
  id uuid [primary key, default: `gen_random_uuid()`]
  code varchar [unique, not null, note: 'Định dạng chuẩn: A0110 (Block + Tầng 2 chữ số + Phòng 2 chữ số)']
  building_code varchar [note: 'Mã tòa: A, B, C']
  floor_number integer [note: 'Số tầng: 1-10']
  area decimal
  is_empty boolean [default: true]
  electric_reading decimal [default: 0]
  water_reading decimal [default: 0]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table residents_apartments {
  id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id]
  apartment_id uuid [ref: > apartments.id]
  relation_role relation_type [default: 'owner', note: 'owner hoặc tenant']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table apartment_link_requests {
  id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id]
  apartment_id uuid [ref: > apartments.id]
  requested_relation_role relation_type [not null]
  status link_request_status [default: 'pending', note: 'pending, approved, rejected']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table invoices {
  id uuid [primary key, default: `gen_random_uuid()`]
  apartment_id uuid [ref: > apartments.id]
  period varchar [not null, note: 'Ví dụ: 08/2026']
  due_date date
  total_amount decimal [default: 0]
  status invoice_status [default: 'unpaid', note: 'unpaid, pending_confirmation, paid, overdue, cancelled']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table invoice_items {
  id uuid [primary key, default: `gen_random_uuid()`]
  invoice_id uuid [ref: > invoices.id]
  fee_type varchar [not null, note: 'Tiền nước, Tiền điện, Phí quản lý...']
  unit_price decimal [default: 0]
  quantity decimal [default: 1]
  subtotal decimal [note: 'GENERATED ALWAYS AS (unit_price * quantity) STORED']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table vehicles {
  id uuid [primary key, default: `gen_random_uuid()`]
  apartment_id uuid [ref: > apartments.id, not null]
  user_id uuid [ref: > users.id, null, note: 'Người đăng ký phương tiện']
  license_plate varchar [unique, not null]
  plate_number varchar [note: 'Đồng bộ biển số']
  vehicle_type varchar [not null, note: 'motorbike, car, bicycle']
  brand_model varchar [note: 'Hãng và mẫu xe']
  status varchar [default: 'pending', note: 'pending, approved, rejected, cancelled']
  notes text
  rejection_reason text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table meter_reading_submissions {
  id uuid [primary key, default: `gen_random_uuid()`]
  apartment_id uuid [ref: > apartments.id, not null]
  submitted_by uuid [ref: > users.id, not null]
  period varchar [not null, note: 'Định dạng MM/yyyy']
  electric_reading decimal [not null]
  water_reading decimal [not null]
  electric_image_url varchar
  water_image_url varchar
  status varchar [default: 'pending', note: 'pending, approved, rejected']
  reject_reason text
  approved_by uuid [ref: > users.id, null]
  approved_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table payment_transactions {
  id uuid [primary key, default: `gen_random_uuid()`]
  invoice_id uuid [ref: > invoices.id, null]
  booking_id uuid [ref: > amenity_bookings.id, null]
  type varchar [default: 'INVOICE', note: 'INVOICE hoặc SERVICE']
  title text
  user_id uuid [ref: > users.id, null]
  apartment_id uuid [ref: > apartments.id, not null]
  amount decimal [not null]
  payment_method varchar [default: 'DEMO', note: 'DEMO, VIETQR, BANK_TRANSFER, CASH']
  status varchar [not null, note: 'PENDING, SUCCESS, FAILED, CANCELLED']
  transaction_code varchar [unique, not null]
  failure_reason text
  confirmed_by uuid [ref: > users.id, null]
  confirmed_at timestamp
  created_at timestamp [default: `now()`]
}

Table building_amenities {
  id uuid [primary key, default: `gen_random_uuid()`]
  name varchar [not null]
  description text
  fee_amount decimal [default: 0, note: 'Giá phí mỗi lượt hoặc mỗi người']
  deposit_amount decimal [default: 0, note: 'Tiền đặt cọc']
  requires_deposit boolean [default: false]
  booking_type varchar [default: 'shared', note: 'shared (dùng chung nhiều người) hoặc exclusive (bao trọn khung giờ)']
  open_hours varchar [default: '06:00 - 22:00']
  open_time time
  close_time time
  slot_duration_minutes integer [default: 60]
  max_capacity integer [default: 1, note: 'Sức chứa tối đa (Hồ bơi: 30, Gym: 20, BBQ: 15, Tennis: 4)']
  display_order integer [default: 0]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table amenity_bookings {
  id uuid [primary key, default: `gen_random_uuid()`]
  amenity_id uuid [ref: > building_amenities.id, not null]
  apartment_id uuid [ref: > apartments.id, not null]
  booked_by uuid [ref: > users.id, not null]
  booking_date date [not null]
  time_slot varchar [not null, note: 'Ví dụ: 08:00 - 09:30']
  guests_count integer [default: 1, note: 'Số lượng người đi cùng trong nhóm']
  fee_amount decimal [default: 0]
  deposit_amount decimal [default: 0]
  deposit_status varchar [default: 'none', note: 'none, pending, unpaid, received, refunded, forfeited']
  deposit_notes text
  checked_in_at timestamp [note: 'Thời điểm ban quản lý điểm danh tại quầy']
  status varchar [default: 'confirmed', note: 'confirmed, pending_payment, waitlist, cancelled, completed, no_show']
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table amenity_maintenance_windows {
  id uuid [primary key, default: `gen_random_uuid()`]
  amenity_id uuid [ref: > building_amenities.id, not null]
  title varchar [not null]
  start_time timestamp [not null]
  end_time timestamp [not null]
  reason text
  created_at timestamp [default: `now()`]
}

Table user_fcm_tokens {
  id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, not null]
  fcm_token text [unique, not null]
  device_type varchar [default: 'android', note: 'android, ios, web']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table building_equipments {
  id uuid [primary key, default: `gen_random_uuid()`]
  equipment_code varchar [unique, not null]
  name varchar [not null]
  category varchar [not null, note: 'elevator, generator, water_pump, fire_alarm, lighting']
  location varchar [not null]
  building_code varchar [not null]
  installation_date date
  warranty_until date
  status varchar [default: 'normal', note: 'normal, maintenance_required, under_repair, out_of_service']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table equipment_maintenance_tasks {
  id uuid [primary key, default: `gen_random_uuid()`]
  equipment_id uuid [ref: > building_equipments.id, not null]
  title varchar [not null]
  description text
  task_type varchar [default: 'routine', note: 'routine, urgent_repair, replacement, inspection']
  scheduled_start timestamp [not null]
  scheduled_end timestamp [not null]
  actual_end timestamp
  status varchar [default: 'scheduled', note: 'scheduled, in_progress, completed, cancelled']
  assigned_to uuid [ref: > users.id, null]
  service_interruption_note text
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table issue_reports {
  id uuid [primary key, default: `gen_random_uuid()`]
  apartment_id uuid [ref: > apartments.id]
  reporter_id uuid [ref: > users.id]
  assigned_staff_id uuid [ref: > users.id, null]
  status issue_status [default: 'pending', note: 'pending, in_progress, resolved']
  priority issue_priority [default: 'medium', note: 'high, medium, low']
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table issue_images {
  id uuid [primary key, default: `gen_random_uuid()`]
  issue_report_id uuid [ref: > issue_reports.id]
  image_url varchar [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table issue_ratings {
  id uuid [primary key, default: `gen_random_uuid()`]
  issue_report_id uuid [unique, not null, note: 'Khóa ngoại 1-1 tới issue_reports']
  reporter_id uuid [not null]
  speed_rating integer [not null, note: 'Tốc độ xử lý: 1-5 sao']
  attitude_rating integer [not null, note: 'Thái độ phục vụ: 1-5 sao']
  quality_rating integer [not null, note: 'Chất lượng kỹ thuật: 1-5 sao']
  overall_rating decimal [note: 'GENERATED ALWAYS AS (ROUND((speed_rating + attitude_rating + quality_rating)::numeric / 3.0, 1)) STORED']
  comment text [note: 'Ý kiến đóng góp của cư dân']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: issue_ratings.issue_report_id - issue_reports.id
Ref: issue_ratings.reporter_id > users.id

Table announcements {
  id uuid [primary key, default: `gen_random_uuid()`]
  title varchar [not null]
  content text
  is_urgent boolean [default: false]
  target_type varchar [default: 'ALL', note: 'Phân nhóm gửi: ALL (Toàn tòa), BUILDING (Theo block), FLOOR (Theo tầng), APARTMENT (Căn hộ đích)']
  target_building varchar [null, note: 'Mã tòa: A, B, C']
  target_floor integer [null, note: 'Số tầng: 1-10']
  target_apartment_id uuid [ref: > apartments.id, null, note: 'Khóa ngoại tới căn hộ đích nhận thông báo riêng']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table notifications {
  id uuid [primary key, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, null]
  title varchar [not null]
  body text [not null]
  type varchar [default: 'general']
  is_read boolean [default: false]
  data jsonb
  created_at timestamp [default: `now()`]
}

Table role_delegations {
  id uuid [primary key, default: `gen_random_uuid()`]
  delegator_id uuid [ref: > users.id, not null]
  delegate_id uuid [ref: > users.id, not null]
  delegated_role varchar [not null, note: 'admin, accountant, technician']
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  notes text
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table password_reset_otps {
  id uuid [primary key, default: `gen_random_uuid()`]
  phone varchar [not null]
  otp_hash varchar [not null]
  expires_at timestamp [not null]
  is_used boolean [default: false]
  attempts_left integer [default: 5]
  created_at timestamp [default: `now()`]
}

Table building_rules {
  id uuid [primary key, default: `gen_random_uuid()`]
  title varchar [not null]
  content text [not null]
  display_order integer [default: 0]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table emergency_contacts {
  id uuid [primary key, default: `gen_random_uuid()`]
  name varchar [not null]
  phone varchar [not null]
  contact_type varchar [default: 'security', note: 'hotline, security, technician']
  display_order integer [default: 0]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}
